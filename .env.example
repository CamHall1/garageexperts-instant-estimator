# Copy to .env.local for development. Never commit real secrets.

# --- Public variables (readable in the browser) -----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps JS key for Places Autocomplete. Must be restricted in the
# Google Cloud Console to: HTTP referrers (your domains) + Maps JavaScript
# API / Places API only. The estimator works with manual address entry if
# this is unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SELECTION_LABEL=

# auto | parent | child | off -- see docs/ANALYTICS.md
NEXT_PUBLIC_TRACKING_MODE=auto

NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Comma-separated list of origins allowed to iframe /embed. Mirrors
# EMBED_ALLOWED_ORIGINS below for the child page's client-side origin check;
# the server-only value below is what's actually enforced via CSP.
NEXT_PUBLIC_EMBED_ALLOWED_ORIGINS=http://localhost:3000

# --- Server-only variables (never sent to the browser) -----------------------

# Two independent GHL inbound webhook URLs. See docs/GHL_SETUP.md.
GHL_ESTIMATE_CREATED_WEBHOOK_URL=
GHL_OPTION_SELECTED_WEBHOOK_URL=

# HMAC-SHA256 secret used to sign the estimate token. Generate with:
#   openssl rand -base64 32
ESTIMATE_SIGNING_SECRET=

# Comma-separated list of origins allowed to iframe /embed (enforced via CSP
# frame-ancestors in middleware.ts). Update this whenever a new landing-page
# domain is introduced.
EMBED_ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-LANDING-DOMAIN.example

# none | postgres -- the app builds and runs fully with "none".
ESTIMATE_STORAGE_PROVIDER=none
DATABASE_URL=

# none | upstash
RATE_LIMIT_PROVIDER=none
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

TURNSTILE_SECRET_KEY=

# ATTOM is not called in V1 regardless of this flag -- see
# docs/ATTOM_FUTURE_INTEGRATION.md.
ATTOM_ENABLED=false
ATTOM_API_KEY=
